# Copy to .env.local for development. Never commit real values. None of these may use NEXT_PUBLIC_ except SITE_URL.

# Public site URL, set once the production domain is known (enables canonical + sitemap URLs)
NEXT_PUBLIC_SITE_URL=

# Set to "true" only when the site is approved for search indexing (default: not indexed)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact form (server only). Without these the form returns a safe "not configured" error.
RESEND_API_KEY=
# Fixed recipient. Visitors can never choose it.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
# For first tests Resend allows "onboarding@resend.dev", delivering only to your own Resend account email.
CONTACT_FROM_EMAIL=
